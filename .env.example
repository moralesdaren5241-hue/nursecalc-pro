# NurseCalc Pro needs no environment variables to develop, test or build the web app.
# There is no backend, API key or remote endpoint.
#
# Android release signing reads these OPTIONAL variables (see docs/ANDROID_RELEASE.md).
# Never commit real values; in GitHub Actions they come from repository secrets.
NURSECALC_UPLOAD_STORE_FILE=
NURSECALC_UPLOAD_STORE_PASSWORD=
NURSECALC_UPLOAD_KEY_ALIAS=
NURSECALC_UPLOAD_KEY_PASSWORD=
